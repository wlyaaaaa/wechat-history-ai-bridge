{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlyaaaaa/wechat-history-ai-bridge/schemas/project-manifest.v1.schema.json",
  "title": "WeFlowBridge Project Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "project",
    "display_name",
    "repository",
    "visibility",
    "role",
    "closeout_status",
    "weflow_baseline",
    "ai_contract_version",
    "integration_readiness",
    "machine_contracts",
    "private_snapshot_handoff",
    "privacy_forbidden",
    "required_output_envelope",
    "ai_contract_v2_fields",
    "retrieval_rules",
    "safe_verification",
    "no_raw_wechat_data"
  ],
  "properties": {
    "schema": {
      "const": "weflowbridge.project_manifest.v1"
    },
    "project": {
      "const": "WeFlowBridge"
    },
    "display_name": {
      "const": "微信聊天记录 AI 本地桥（WeChat History AI Bridge）"
    },
    "repository": {
      "const": "wlyaaaaa/wechat-history-ai-bridge"
    },
    "visibility": {
      "const": "public"
    },
    "role": {
      "const": "provider_facing_adapter"
    },
    "closeout_status": {
      "const": "ready_for_normal_maintenance"
    },
    "weflow_baseline": {
      "type": "object",
      "required": ["version", "product_version", "verified_on", "requires_reprobe_after_version_change"],
      "properties": {
        "version": {
          "const": "26.7.3"
        },
        "product_version": {
          "const": "26.7.3.0"
        },
        "verified_on": {
          "const": "2026-07-09"
        },
        "requires_reprobe_after_version_change": {
          "const": true
        }
      }
    },
    "ai_contract_version": {
      "const": "v2"
    },
    "integration_readiness": {
      "type": "object",
      "required": ["status", "release_tag", "completed_on", "definition"],
      "properties": {
        "status": {
          "const": "ai_integration_1_0_ready"
        },
        "release_tag": {
          "const": "v0.1.0"
        },
        "completed_on": {
          "const": "2026-07-09"
        },
        "definition": {
          "type": "string"
        }
      }
    },
    "machine_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openapi",
        "ai_consumer_envelope_schema",
        "project_manifest_schema",
        "ai_consumer_envelope_example"
      ],
      "properties": {
        "openapi": {
          "const": "docs/openapi.yaml"
        },
        "ai_consumer_envelope_schema": {
          "const": "schemas/ai-consumer-envelope.v2.schema.json"
        },
        "project_manifest_schema": {
          "const": "schemas/project-manifest.v1.schema.json"
        },
        "ai_consumer_envelope_example": {
          "const": "docs/examples/ai_consumer_envelope.example.json"
        }
      }
    },
    "private_snapshot_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner_boundary",
        "allowed_consumer",
        "allowed_payloads",
        "requirements",
        "forbidden"
      ],
      "properties": {
        "status": {
          "const": "allowed_for_explicitly_authorized_private_consumer"
        },
        "owner_boundary": {
          "const": "WeFlow/WeLive owns source data, decryption, and export implementation; WeFlowBridge owns version-bound adaptation, handoff, and verification contracts; PersonalOS owns the authorized private immutable package and derived representations"
        },
        "allowed_consumer": {
          "const": "PersonalOS private late-bound runtime"
        },
        "allowed_payloads": {
          "const": [
            "account-scoped immutable source-native exports",
            "database and WAL/SHM recovery snapshots",
            "media payloads and manifests",
            "hashes, coverage, lineage, checkpoints, and gap receipts"
          ]
        },
        "requirements": {
          "const": [
            "explicit user source authorization",
            "private non-repository destination",
            "one account identity and checkpoint namespace per source instance",
            "version-bound export contract and complete output verification",
            "no source write-back and no second writable WeFlow state"
          ]
        },
        "forbidden": {
          "const": [
            "raw payloads in this public repository",
            "secrets in argv, logs, receipts, or Git",
            "treating an empty or partial export as complete",
            "making ordinary PersonalOS queries depend on WeFlow being online"
          ]
        }
      }
    },
    "no_raw_wechat_data": {
      "const": true
    }
  }
}
